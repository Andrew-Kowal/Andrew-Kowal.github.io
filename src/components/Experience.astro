---
const experience = [
  {
    role: 'Operations Engineering Intern',
    company: 'Flex',
    dates: 'June – August 2026',
    lines: [
      'Built full-stack industrial dashboards for 5 CNC/EDM machines in Node-RED, with automated pipelines logging runtime and status signals to SQL Server Express.',
      'Raised machine uptime tracking from under 5% to 99.8%, removing reliance on operator reporting, and secured $20K to add aftermarket MTConnect and OPC-UA support.',
    ],
    projectHref: '/projects/machine-monitoring-system/',
    projectLabel: 'Machine Monitoring System',
  },
  {
    role: 'Continuous Improvement Engineering Intern',
    company: 'Pursuit Aerospace',
    dates: 'May – August 2025',
    lines: [
      'Improved one-piece flow line efficiency by 50%+ in flight-critical aerospace component manufacturing.',
      'Programmed a C++ automated measure-and-cut system for Velcro and soldered its BLDC motor, rotary encoder, and LCD; applied Arduino, CAD, and CREFORM across Kaizen and Lean/Six Sigma initiatives.',
    ],
    projectHref: '/projects/velcro-measure-and-cut-system/',
    projectLabel: 'Velcro Measure-and-Cut System',
  },
];
---

<section id="experience" class="section">
  <div class="container">
    <span class="section-label mono">02 &mdash; Experience</span>
    <h2 class="section-title">Experience</h2>

    <ol class="timeline">
      {
        experience.map((job) => (
          <li class="timeline-item">
            <div class="timeline-head">
              <h3>{job.role} &middot; {job.company}</h3>
              <span class="mono dates">{job.dates}</span>
            </div>
            <ul class="lines">
              {job.lines.map((line) => <li>{line}</li>)}
            </ul>
            <a class="mono related-link" href={job.projectHref}>
              Related project: {job.projectLabel} &rarr;
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline-item {
    padding-left: 1.25rem;
    border-left: 2px solid var(--border-strong);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .timeline-head h3 {
    font-size: 1.05rem;
  }

  .dates {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .related-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--accent);
  }

  .related-link:hover {
    text-decoration: underline;
  }
</style>
