---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  status: 'in-progress' | 'complete';
  thumbnail?: { src: ImageMetadata; alt: string };
}

const { slug, title, summary, tags, status, thumbnail } = Astro.props;
---

<article class="project-card card" data-tags={tags.join(',')}>
  <a href={`/projects/${slug}/`} class="card-link">
    <div class="thumb">
      {
        thumbnail ? (
          <Image src={thumbnail.src} alt={thumbnail.alt} width={480} />
        ) : (
          <span class="mono thumb-label" aria-hidden="true">
            Image TODO
          </span>
        )
      }
    </div>
    <div class="card-body">
      <div class="card-heading">
        <h3>{title}</h3>
        {status === 'in-progress' && <span class="badge">In progress</span>}
      </div>
      <p class="muted summary">{summary}</p>
      <ul class="tag-list">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
      <span class="btn btn-primary card-cta">Learn More</span>
    </div>
  </a>
</article>

<style>
  .project-card {
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .project-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .card-link {
    display: block;
  }

  .thumb {
    aspect-ratio: 16 / 9;
    background: color-mix(in srgb, var(--border) 60%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .card-body {
    padding: 1.5rem;
  }

  .card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .card-heading h3 {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .summary {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .tag-list {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    list-style: none;
    margin-bottom: 1.25rem;
  }

  .card-cta {
    width: 100%;
  }
</style>
