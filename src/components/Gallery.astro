---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src: ImageMetadata; alt: string }[];
}

const { items } = Astro.props;
---

<ul class="gallery">
  {
    items.map((item) => (
      <li class="gallery-item">
        <a href={item.src.src} target="_blank" rel="noopener noreferrer">
          <Image src={item.src} alt={item.alt} width={640} loading="lazy" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 40rem) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .gallery-item a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .gallery-item a:hover :global(img),
  .gallery-item a:focus-visible :global(img) {
    transform: scale(1.03);
  }
</style>
