---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page not found — Andrew H. Kowal" description="This page doesn't exist.">
  <Header />
  <main id="main">
    <section class="section not-found">
      <div class="container">
        <span class="section-label mono">404</span>
        <h1 class="section-title">Page not found</h1>
        <p class="muted">The page you're looking for doesn't exist or has moved.</p>
        <a class="btn btn-primary home-link" href="/">Back to home</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    text-align: center;
  }

  .home-link {
    margin-top: 1.5rem;
  }
</style>
